{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@clapp/common": ["../common/dist/clapp-common.d.ts"],
      "@clapp/command": ["../command/dist/clapp-command.d.ts"],
      "@clapp/core": ["../core/dist/clapp-core.d.ts"],
      "@clapp/utils": ["../utils/dist/clapp-utils.d.ts"]
    }
  },
  // The command plugins of this package now live under `src/plugins/**`, so the
  // whole `src/**` tree (library plus plugins) goes to `dist` — the build is
  // out of scope for now, but the layout is uniform.
  "include": ["src/**/*.ts"]
}
